<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F8FAFD">

    <ProgressBar
        android:id="@+id/processingProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/tvProcessingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Analyzing Symptoms"
        android:textColor="#17233C"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProcessingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Analyzing your symptoms..."
        android:textColor="#667085"
        android:textSize="14sp" />

</LinearLayout>